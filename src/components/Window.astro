---
// A terminal-style window frame with traffic-light dots and a file name.
interface Props {
  title: string;
  class?: string;
  flush?: boolean;
}

const { title, class: className, flush = false } = Astro.props;
---

<div class:list={['window', className]}>
  <div class="bar">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="title">{title}</span>
  </div>
  <div class:list={['content', { flush }]}>
    <slot />
  </div>
</div>

<style>
  .window {
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-raised);
    overflow: hidden;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 2.25rem;
    padding-inline: 0.875rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-sunken);
  }

  .dots {
    display: flex;
    gap: 0.375rem;
  }

  .dots i {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .title {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .content {
    padding: 1.5rem;
  }

  .content.flush {
    padding: 0;
  }

  @media (min-width: 48rem) {
    .content:not(.flush) {
      padding: 2rem 2.25rem;
    }
  }
</style>
