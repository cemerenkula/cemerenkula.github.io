---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
---

<header class="header">
  <div class="container container-wide inner">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <span class="mark" aria-hidden="true">ck</span>
      <span class="brand-name">{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
        <span class="icon-sun"><Icon name="sun" size={17} /></span>
        <span class="icon-moon"><Icon name="moon" size={17} /></span>
      </button>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--band-top);
    color: var(--band-text);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand:hover {
    color: var(--band-text);
  }

  .mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    background: #ffffff;
    color: #11294c;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    transition: transform 0.2s;
  }

  .brand:hover .mark {
    transform: rotate(-6deg);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  ul {
    display: flex;
    gap: 0.125rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 0.375rem 0.625rem;
    border-radius: 8px;
    font-size: 0.9375rem;
    color: var(--band-muted);
    text-decoration: none;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--band-text);
    background: var(--glass);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: 0.25rem;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    background: var(--glass);
    color: var(--band-text);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .theme-toggle:hover {
    background: rgb(255 255 255 / 0.2);
    border-color: rgb(255 255 255 / 0.6);
  }

  .icon-sun,
  .icon-moon {
    display: grid;
  }

  :global([data-theme='dark']) .icon-moon,
  :global(:root:not([data-theme='dark'])) .icon-sun {
    display: none;
  }

  @media (max-width: 30rem) {
    .brand-name {
      display: none;
    }
    nav a {
      padding-inline: 0.5rem;
    }
  }
</style>
