---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
import { publications } from '../data/publications';

const path = Astro.url.pathname;
const items =
  publications.length > 0
    ? [...nav.slice(0, 1), { href: '/publications/', label: 'Publications' }, ...nav.slice(1)]
    : nav;
---

<header class="container header">
  <a href="/" class="name">{site.name}</a>
  <nav aria-label="Main">
    {
      items.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
      <span class="icon-sun"><Icon name="sun" size={16} /></span>
      <span class="icon-moon"><Icon name="moon" size={16} /></span>
    </button>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .name {
    font-weight: 600;
    color: var(--text);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }

  nav a {
    color: var(--text-muted);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    padding: 0.25rem;
    border: 0;
    background: none;
    color: var(--text-muted);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  .icon-sun,
  .icon-moon {
    display: grid;
  }

  :global([data-theme='dark']) .icon-moon,
  :global(:root:not([data-theme='dark'])) .icon-sun {
    display: none;
  }

  @media (max-width: 26rem) {
    nav {
      gap: 0.875rem;
    }
  }
</style>
