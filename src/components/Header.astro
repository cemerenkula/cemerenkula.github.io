---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname;
---

<header class="header">
  <div class="container container-wide inner">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <span class="tilde">~/</span>cemerenkula<span class="cursor" aria-hidden="true"></span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                {item.label.toLowerCase()}
              </a>
            </li>
          ))
        }
      </ul>
      <button class="theme-toggle" type="button" aria-label="Toggle light mode">
        <span class="icon-sun"><Icon name="sun" size={16} /></span>
        <span class="icon-moon"><Icon name="moon" size={16} /></span>
      </button>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .brand:hover {
    color: var(--text);
  }

  .tilde {
    color: var(--accent);
  }

  .cursor {
    display: inline-block;
    width: 0.5em;
    height: 1.1em;
    margin-left: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.15s;
  }

  .brand:hover .cursor {
    opacity: 1;
    animation: blink 1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  ul {
    display: flex;
    gap: 0.125rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: block;
    padding: 0.375rem 0.625rem;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
  }

  nav a[aria-current='page']::before {
    content: '> ';
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    margin-left: 0.375rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .icon-sun,
  .icon-moon {
    display: grid;
  }

  :global(:root:not([data-theme='light'])) .icon-moon,
  :global([data-theme='light']) .icon-sun {
    display: none;
  }

  @media (max-width: 30rem) {
    .brand {
      font-size: 0.875rem;
    }
    nav a {
      padding-inline: 0.4rem;
    }
    nav a[aria-current='page']::before {
      content: '';
    }
  }
</style>
