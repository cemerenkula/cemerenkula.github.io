---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        {post.data.draft && <span class="draft">(draft)</span>}
        <span class="date">
          <FormattedDate date={post.data.date} format="short" />
        </span>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 0.375rem;
  }

  a {
    color: var(--text);
  }

  .draft {
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .date {
    margin-left: auto;
    padding-left: 1rem;
    flex-shrink: 0;
    font-size: 0.875rem;
    color: var(--text-faint);
  }
</style>
