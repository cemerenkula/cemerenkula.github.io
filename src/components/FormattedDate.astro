---
interface Props {
  date: Date;
  format?: 'long' | 'short';
}

const { date, format = 'long' } = Astro.props;
const text = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: format === 'long' ? 'long' : 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<time datetime={date.toISOString()}>{text}</time>
