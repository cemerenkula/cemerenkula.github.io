---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { title, summary, tags, cover, coverAlt } = project.data;
---

<article class="card">
  <div class="media">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[400, 640, 960]}
      sizes="(max-width: 40rem) 100vw, (max-width: 68rem) 50vw, 360px"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="body">
    <p class="eyebrow">~/projects/{project.id}</p>
    <h3>
      <a href={`/projects/${project.id}/`}>
        {title}
        <span class="arrow"><Icon name="arrow-right" size={16} /></span>
      </a>
    </h3>
    <p class="summary">{summary}</p>
    <ul class="tags">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-raised);
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .card:hover {
    border-color: var(--accent);
    box-shadow: var(--glow);
  }

  .media {
    aspect-ratio: 16 / 10;
    background: var(--bg-sunken);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }

  .card:hover .media img {
    transform: scale(1.03);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    padding: 1rem 1.125rem 1.125rem;
  }

  .eyebrow {
    font-size: 0.75rem;
  }

  h3 {
    font-size: 1.125rem;
    margin: 0;
  }

  h3 a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    text-decoration: none;
  }

  /* Make the whole card clickable */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .arrow {
    display: grid;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s, transform 0.2s;
  }

  .card:hover .arrow {
    opacity: 1;
    transform: none;
  }

  .summary {
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
    flex: 1;
  }
</style>
