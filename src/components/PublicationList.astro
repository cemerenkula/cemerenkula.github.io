---
import { me, statusLabel, type Publication } from '../data/publications';

interface Props {
  publications: Publication[];
  // Full shows the summary, abstract and BibTeX; compact is for the home page and CV.
  variant?: 'full' | 'compact';
}

const { publications, variant = 'compact' } = Astro.props;
const full = variant === 'full';
---

<ol class:list={['pubs', { full }]}>
  {
    publications.map((pub) => (
      <li id={full ? pub.id : undefined}>
        <p class="badges">
          <span>{pub.venueShort}</span>
          <span class="status">{statusLabel[pub.status]}</span>
        </p>
        <h3>{full ? pub.title : <a href={`/publications/#${pub.id}`}>{pub.title}</a>}</h3>
        <p class="authors">
          {pub.authors.map((author, i) => (
            <>
              {author === me ? <strong>{author}</strong> : author}
              {i < pub.authors.length - 1 && ', '}
            </>
          ))}
        </p>
        <p class="venue">
          <em>{pub.venue}</em>
          {pub.pages && <>, pp. {pub.pages}</>}, {pub.year}
        </p>
        {pub.doi && (
          <p class="doi">
            DOI:{' '}
            {pub.doiLive ? (
              <a href={`https://doi.org/${pub.doi}`}>{pub.doi}</a>
            ) : (
              <>
                {pub.doi} <span class="soon">(link available soon)</span>
              </>
            )}
          </p>
        )}

        {full && (
          <>
            <p class="summary">{pub.summary}</p>
            {pub.links && pub.links.length > 0 && (
              <p class="links">
                {pub.links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </p>
            )}
            <details>
              <summary>Abstract</summary>
              <p>{pub.abstract}</p>
              <p class="keywords">Keywords: {pub.keywords.join(', ')}</p>
            </details>
            <details>
              <summary>BibTeX</summary>
              <div class="bibtex">
                <pre><code>{pub.bibtex}</code></pre>
                <button type="button" class="copy" data-copy={pub.bibtex}>
                  Copy
                </button>
              </div>
            </details>
          </>
        )}
      </li>
    ))
  }
</ol>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1500);
    });
  });
</script>

<style>
  .pubs {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    margin-top: 2rem;
  }

  .full li + li {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  p {
    margin: 0;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .badges span {
    padding: 0.0625rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  h3 {
    font-size: 1.0625rem;
    line-height: 1.4;
    margin: 0 0 0.375rem;
  }

  h3 a {
    color: var(--text);
  }

  .authors,
  .venue,
  .doi {
    font-size: 0.9375rem;
    color: var(--text-muted);
  }

  .authors strong {
    color: var(--text);
    font-weight: 600;
  }

  .soon {
    color: var(--text-faint);
  }

  .summary {
    margin-top: 1rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }

  details {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }

  summary {
    cursor: pointer;
    color: var(--accent);
    width: fit-content;
  }

  details p {
    margin-top: 0.5rem;
  }

  .keywords {
    color: var(--text-muted);
  }

  .bibtex {
    position: relative;
    margin-top: 0.5rem;
  }

  pre {
    margin: 0;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--code-bg);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  .copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .copy:hover {
    color: var(--text);
  }
</style>
