---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul class="projects">
  {
    projects.map((project) => (
      <li>
        <a href={`/projects/${project.id}/`} class="thumb" tabindex="-1" aria-hidden="true">
          <Image src={project.data.cover} alt="" widths={[160, 320]} sizes="160px" />
        </a>
        <div>
          <h3>
            <a href={`/projects/${project.id}/`}>{project.data.title}</a>
          </h3>
          <p class="summary">{project.data.summary}</p>
          <p class="tags">{project.data.tags.join(' · ')}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--border);
  }

  li:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .thumb img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  h3 {
    font-size: 1.0625rem;
    margin: 0 0 0.25rem;
  }

  h3 a {
    color: var(--text);
  }

  .summary {
    margin: 0 0 0.375rem;
    color: var(--text-muted);
    font-size: 0.9688rem;
    line-height: 1.6;
  }

  .tags {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  @media (max-width: 30rem) {
    li {
      grid-template-columns: 5.5rem 1fr;
      gap: 1rem;
    }
  }
</style>
