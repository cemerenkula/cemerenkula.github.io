---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found">
  <div class="container wrap">
    <p class="prompt">cd {Astro.url.pathname}</p>
    <p class="code">bash: {Astro.url.pathname}: No such file or directory</p>
    <h1>404</h1>
    <p>The link may be broken, or the page may have moved.</p>
    <a class="button button-primary" href="/"><Icon name="arrow-left" size={16} /> cd ~</a>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-block: 6rem 2rem;
  }

  .code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: #ff7b72;
    margin: 0.25rem 0 0;
    overflow-wrap: anywhere;
  }

  h1 {
    font-size: clamp(4rem, 14vw, 7rem);
    line-height: 1;
    color: var(--accent);
    margin: 2rem 0 1rem;
  }

  p:not(.prompt):not(.code) {
    color: var(--text-muted);
    margin: 0 0 2rem;
  }
</style>
