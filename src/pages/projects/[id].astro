---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, category, tags, cover, coverAlt, links } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary} image={cover} type="article">
  <article>
    <header class="band head">
      <div class="container">
      <a class="back" href="/projects/"><Icon name="arrow-left" size={15} /> All projects</a>
      <p class="eyebrow">{category}</p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <ul class="tags">
        {tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
      {
        (links.github || links.demo || links.video) && (
          <div class="links">
            {links.github && (
              <a class="button" href={links.github}>
                <Icon name="github" size={16} /> Source
              </a>
            )}
            {links.demo && (
              <a class="button button-primary" href={links.demo}>
                <Icon name="arrow-up-right" size={16} /> Live demo
              </a>
            )}
            {links.video && (
              <a class="button" href={links.video}>
                <Icon name="play" size={16} /> Video
              </a>
            )}
          </div>
        )
      }
      </div>
    </header>

    <div class="container container-wide cover-wrap">
      <Image
        class="cover"
        src={cover}
        alt={coverAlt}
        widths={[640, 1024, 1600]}
        sizes="(max-width: 68rem) 100vw, 1088px"
        loading="eager"
      />
    </div>

    <div class="container">
      <div class="panel prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: 2.5rem 7rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 2rem;
    font-size: 0.875rem;
    color: var(--band-muted);
    text-decoration: none;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.03em;
    margin: 0.375rem 0 0.75rem;
  }

  .summary {
    font-size: 1.1875rem;
    color: var(--band-muted);
    margin: 0 0 1.25rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .cover {
    width: 100%;
    max-height: 34rem;
    object-fit: contain;
    background: var(--bg-raised);
    border-radius: 20px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    margin-bottom: 2rem;
  }

  .cover-wrap {
    margin-top: -5rem;
    position: relative;
  }
</style>
