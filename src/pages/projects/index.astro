---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Software and game projects by Cem Eren Kula.">
  <div class="container">
    <header class="page-head">
      <h1>Projects</h1>
      <p>Backend services, Unity games and algorithm projects, from coursework to side projects.</p>
    </header>
    <ProjectList projects={projects} />
  </div>
</BaseLayout>
