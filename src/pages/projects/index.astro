---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const categories = ['All', ...new Set(projects.map((p) => p.data.category))];
---

<BaseLayout title="Projects" description="Software, games and AI projects by Cem Eren Kula.">
  <header class="band">
    <div class="container container-wide page-head">
      <p class="eyebrow">Projects</p>
      <h1>Things I've built</h1>
      <p>Backend services, Unity games and game AI experiments, from coursework to side projects.</p>
    </div>
  </header>

  <div class="container container-wide">

    <div class="filters" role="group" aria-label="Filter by category">
      {
        categories.map((c, i) => (
          <button type="button" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}>
            {c}
          </button>
        ))
      }
    </div>

    <div class="grid">
      {
        projects.map((project, i) => (
          <div data-category={project.data.category}>
            <ProjectCard project={project} eager={i < 2} />
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-category]');

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      items.forEach((item) => {
        item.hidden = filter !== 'All' && item.dataset.category !== filter;
      });
    });
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0;
  }

  .filters button {
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-raised);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .filters button:hover {
    color: var(--text);
    border-color: var(--text-faint);
  }

  .filters button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg-raised);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
  }

  .grid > div {
    display: grid;
  }

  .grid > div[hidden] {
    display: none;
  }
</style>
