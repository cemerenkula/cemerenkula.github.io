---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Notes on software, games and things I'm learning.">
  <div class="container">
    <header class="page-head">
      <h1>Blog</h1>
      <p>Notes on software and things I'm learning. <a href="/rss.xml">RSS</a></p>
    </header>
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="muted">No posts yet.</p>}
  </div>
</BaseLayout>
