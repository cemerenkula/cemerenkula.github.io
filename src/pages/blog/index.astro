---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import Icon from '../../components/Icon.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Notes on software, games and things I'm learning.">
  <header class="band">
    <div class="container page-head">
      <p class="eyebrow">Blog</p>
      <h1>Writing</h1>
      <p>Notes on software, games and things I'm learning along the way.</p>
      <a class="rss" href="/rss.xml"><Icon name="rss" size={15} /> RSS feed</a>
    </div>
  </header>

  <div class="container">
    <div class="list panel">
      {posts.length > 0 ? <PostList posts={posts} /> : <p class="empty">No posts yet. Check back soon.</p>}
    </div>
  </div>
</BaseLayout>

<style>
  .rss {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--band-muted);
    text-decoration: none;
  }

  .list {
    margin-top: 2rem;
  }

  .empty {
    margin: 0;
    padding: 1.5rem 1rem;
    color: var(--text-muted);
    text-align: center;
  }
</style>
