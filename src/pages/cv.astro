---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { experience, education, skills, interests, cvPdf, type CvEntry } from '../data/cv';

const sections: { title: string; entries: CvEntry[] }[] = [
  { title: 'Experience', entries: experience },
  { title: 'Education', entries: education },
];
---

<BaseLayout title="CV" description={`Experience, education and skills of ${site.name}.`}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Curriculum vitae</p>
      <h1>{site.name}</h1>
      <p>{site.role} · {site.location}</p>
      <div class="actions">
        {
          cvPdf && (
            <a class="button button-primary" href={cvPdf} download>
              <Icon name="download" size={16} /> Download PDF
            </a>
          )
        }
        <a class="button" href={`mailto:${site.email}`}><Icon name="mail" size={16} /> Email</a>
        <a class="button" href={site.links.linkedin}><Icon name="linkedin" size={16} /> LinkedIn</a>
      </div>
    </header>

    {
      sections.map((section) => (
        <section class="cv-section">
          <h2>{section.title}</h2>
          <ol class="entries">
            {section.entries.map((entry) => (
              <li class="entry">
                <div class="entry-head">
                  <h3>{entry.title}</h3>
                  {entry.period && <span class="period">{entry.period}</span>}
                </div>
                <p class="org">
                  {entry.org}
                  {entry.location && <span> · {entry.location}</span>}
                </p>
                {entry.points && entry.points.length > 0 && (
                  <ul class="points">
                    {entry.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <section class="cv-section">
      <h2>Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>
                <ul class="tags">
                  {s.items.map((item) => (
                    <li class="tag">{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv-section">
      <h2>Interests</h2>
      <p class="interests">{interests.join(' · ')}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .cv-section {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--border);
  }

  .cv-section:first-of-type {
    margin-top: 2rem;
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0.25rem 0 0;
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  h3 {
    font-size: 1.0625rem;
    margin: 0;
  }

  .period {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .org {
    margin: 0.125rem 0 0;
    color: var(--text-muted);
  }

  .points {
    margin: 0.625rem 0 0;
    padding-left: 1.125rem;
    color: var(--text-muted);
    font-size: 0.9688rem;
  }

  .points li {
    margin-bottom: 0.25rem;
  }

  .skills {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  dt {
    font-weight: 500;
    margin-bottom: 0.375rem;
  }

  dd {
    margin: 0;
  }

  .interests {
    margin: 0;
    color: var(--text-muted);
  }

  @media (max-width: 36rem) {
    .cv-section {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
