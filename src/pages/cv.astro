---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { experience, education, skills, interests, cvPdf, type CvEntry } from '../data/cv';

const sections: { title: string; entries: CvEntry[] }[] = [
  { title: 'Experience', entries: experience },
  { title: 'Education', entries: education },
];
---

<BaseLayout title="CV" description={`Experience, education and skills of ${site.name}.`}>
  <div class="container">
    <header class="page-head">
      <h1>CV</h1>
      <p>
        {site.role} · {site.location}
        {cvPdf && <> · <a href={cvPdf} download>Download PDF</a></>}
      </p>
    </header>

    {
      sections.map((section) => (
        <section class="block">
          <h2 class="section-title">{section.title}</h2>
          {section.entries.map((entry) => (
            <div class="entry">
              <div class="entry-head">
                <h3>{entry.title}</h3>
                {entry.period && <span class="period">{entry.period}</span>}
              </div>
              <p class="org">
                {entry.org}
                {entry.location && <>, {entry.location}</>}
              </p>
              {entry.points && entry.points.length > 0 && (
                <ul>
                  {entry.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </section>
      ))
    }

    <section class="block">
      <h2 class="section-title">Skills</h2>
      <dl class="skills">
        {
          skills.map((s) => (
            <>
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <section class="block">
      <h2 class="section-title">Interests</h2>
      <p class="muted">{interests.join(', ')}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .block {
    margin-bottom: 2.5rem;
  }

  .entry + .entry {
    margin-top: 1.25rem;
  }

  .entry-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  h3 {
    font-size: 1rem;
    margin: 0;
  }

  .period {
    flex-shrink: 0;
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .org {
    margin: 0;
    color: var(--text-muted);
  }

  ul {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
    color: var(--text-muted);
  }

  .skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.375rem 1.5rem;
    margin: 0;
  }

  dt {
    font-weight: 500;
  }

  dd {
    margin: 0;
    color: var(--text-muted);
  }

  .block p {
    margin: 0;
  }

  @media (max-width: 30rem) {
    .skills {
      grid-template-columns: 1fr;
      gap: 0;
    }
    dd {
      margin-bottom: 0.625rem;
    }
  }
</style>
