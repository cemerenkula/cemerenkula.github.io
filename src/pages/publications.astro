---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import { publications } from '../data/publications';
---

<BaseLayout title="Publications" description="Peer-reviewed papers by Cem Eren Kula.">
  <div class="container">
    <header class="page-head">
      <h1>Publications</h1>
      <p>Peer-reviewed papers, newest first.</p>
    </header>
    {
      publications.length > 0 ? (
        <PublicationList publications={publications} variant="full" />
      ) : (
        <p class="muted">Coming soon.</p>
      )
    }
  </div>
</BaseLayout>
