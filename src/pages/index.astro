---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import PublicationList from '../components/PublicationList.astro';
import { publications } from '../data/publications';
import { getFeaturedProjects, getPosts } from '../lib/content';
import { site } from '../data/site';
import profile from '../assets/profile.jpg';

const featured = await getFeaturedProjects();
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <div class="container">
    <section class="intro">
      <Image
        class="photo"
        src={profile}
        alt="Cem Eren Kula"
        widths={[96, 192]}
        sizes="96px"
        loading="eager"
      />
      <h1>{site.name}</h1>
      <p class="muted">{site.role} · {site.location}</p>
      <p>
        I'm a full stack software engineer at Exairon and a computer engineering graduate of Marmara
        University. Day to day I build full stack web applications with React and Node.js, but I enjoy every part
        of computing: hardware, networking, cyber security and game development.
      </p>
      <p>
        Outside of work I enjoy dancing, hiking, skiing and kitesurfing.
      </p>
      <p class="links">
        <a href={site.links.github}>GitHub</a>
        <a href={site.links.linkedin}>LinkedIn</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </section>

    {
      publications.length > 0 && (
        <section class="section">
          <h2 class="section-title">Publications</h2>
          <PublicationList publications={publications} />
        </section>
      )
    }

    <section class="section">
      <h2 class="section-title">Projects</h2>
      <ProjectList projects={featured} />
      <p class="more"><a href="/projects/">All projects →</a></p>
    </section>

    {
      posts.length > 0 && (
        <section class="section">
          <h2 class="section-title">Writing</h2>
          <PostList posts={posts} />
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .intro {
    padding-top: 2.5rem;
  }

  .intro :global(.photo) {
    width: 6rem;
    height: 6rem;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 50%;
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 1.75rem;
    margin: 0 0 0.25rem;
  }

  .intro p {
    margin: 0 0 1rem;
  }

  .intro .muted {
    margin-bottom: 1.5rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .more {
    margin: 1rem 0 0;
    font-size: 0.9375rem;
  }
</style>
